          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "object": {
          "$ref": "#/definitions/ObjectWithJson"
        }
      },
      "required": [
        "date",
        "number",
        "object"
      ],
      "type": "object"
    },
    "ObjectWithJson": {
      "additionalProperties": false,
      "properties": {
        "hello": {
          "type": "string"
        }
      },
      "required": [
        "hello"
      ],
      "type": "object"
    }
  }
}
